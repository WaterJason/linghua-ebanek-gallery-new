import { NextResponse } from "next/server"
import prisma from "@/lib/db"

// 获取所有产品分类
export async function GET() {
  try {
    // 从产品表中提取所有不同的分类
    const products = await prisma.product.findMany({
      select: {
        category: true,
      },
      where: {
        category: {
          not: null,
        },
      },
      distinct: ['category'],
    })

    // 将分类转换为分类对象数组
    const categories = products
      .filter(p => p.category) // 过滤掉null值
      .map((p, index) => ({
        id: index + 1, // 生成虚拟ID
        name: p.category,
        description: "",
        productCount: 0, // 将在前端计算
      }))

    return NextResponse.json(categories)
  } catch (error) {
    console.error("Error fetching product categories:", error)
    return NextResponse.json({ error: "Failed to fetch product categories" }, { status: 500 })
  }
}

// 添加新分类
export async function POST(request: Request) {
  try {
    // 解析请求数据
    let data;
    try {
      data = await request.json();
      console.log("Creating category with data:", data);
    } catch (parseError) {
      console.error("Error parsing request data:", parseError);
      return NextResponse.json({
        error: "Invalid request data format",
        details: "Could not parse JSON data"
      }, { status: 400 });
    }

    // 验证必填字段
    if (!data.name || data.name.trim() === "") {
      return NextResponse.json({
        error: "Category name is required",
        details: "分类名称不能为空"
      }, { status: 400 });
    }

    // 规范化分类名称
    const categoryName = data.name.trim();

    // 检查分类是否已存在
    try {
      const existingProducts = await prisma.product.findMany({
        where: {
          category: categoryName,
        },
      });

      if (existingProducts.length > 0) {
        return NextResponse.json({
          error: "Category already exists",
          details: "分类名称已存在，请使用其他名称"
        }, { status: 400 });
      }
    } catch (dbError) {
      console.error("Database error checking existing category:", dbError);
      return NextResponse.json({
        error: "Database error checking category",
        details: dbError.message || "数据库查询错误"
      }, { status: 500 });
    }

    // 创建一个虚拟分类对象
    const newCategory = {
      id: Date.now(), // 生成一个唯一ID
      name: categoryName,
      description: data.description || "",
      productCount: 0,
    };

    try {
      // 创建一个带有此分类的占位产品
      // 这是必要的，因为系统从产品表中提取分类
      const placeholderProduct = await prisma.product.create({
        data: {
          name: `${categoryName} 分类`,
          price: 0,
          commissionRate: 0,
          type: "category_placeholder",
          category: categoryName,
          description: `${categoryName} 分类的占位产品`,
          status: "inactive", // 设为非活动状态，不会显示在产品列表中
        },
      });

      console.log("Category placeholder product created:", placeholderProduct);
      console.log("New category created:", newCategory);

      return NextResponse.json(newCategory);
    } catch (dbError) {
      console.error("Database error creating category placeholder product:", dbError);
      return NextResponse.json({
        error: "Database error creating category",
        details: dbError.message || "创建分类占位产品失败"
      }, { status: 500 });
    }
  } catch (error) {
    console.error("Error creating product category:", error);
    return NextResponse.json({
      error: "Failed to create product category",
      details: error instanceof Error ? error.message : "未知错误"
    }, { status: 500 });
  }
}

// 更新分类
export async function PUT(request: Request) {
  try {
    // 解析请求数据
    let data;
    try {
      data = await request.json();
      console.log("Updating category with data:", data);
    } catch (parseError) {
      console.error("Error parsing request data:", parseError);
      return NextResponse.json({
        error: "Invalid request data format",
        details: "Could not parse JSON data"
      }, { status: 400 });
    }

    const { id, name, oldName } = data;

    // 验证必填字段
    if (!oldName || !name) {
      return NextResponse.json({
        error: "Old category name and new name are required",
        details: "需要提供原分类名称和新分类名称"
      }, { status: 400 });
    }

    // 规范化分类名称
    const newCategoryName = name.trim();

    // 如果新名称与旧名称相同，直接返回成功
    if (newCategoryName === oldName.trim()) {
      const unchangedCategory = {
        id,
        name: newCategoryName,
        description: data.description || "",
        productCount: 0, // 将在前端计算
      };
      return NextResponse.json(unchangedCategory);
    }

    // 检查新分类名称是否已存在（排除当前分类）
    try {
      const existingProducts = await prisma.product.findMany({
        where: {
          category: newCategoryName,
          NOT: {
            category: oldName
          }
        },
      });

      if (existingProducts.length > 0) {
        return NextResponse.json({
          error: "Category name already exists",
          details: "分类名称已存在，请使用其他名称"
        }, { status: 400 });
      }
    } catch (dbError) {
      console.error("Database error checking existing category:", dbError);
      return NextResponse.json({
        error: "Database error checking category",
        details: dbError.message || "数据库查询错误"
      }, { status: 500 });
    }

    try {
      // 更新所有使用此分类的产品
      const updateResult = await prisma.product.updateMany({
        where: {
          category: oldName,
        },
        data: {
          category: newCategoryName,
        },
      });

      console.log("Updated products with category:", updateResult);

      // 返回更新后的分类
      const updatedCategory = {
        id,
        name: newCategoryName,
        description: data.description || "",
        productCount: 0, // 将在前端计算
      };

      return NextResponse.json(updatedCategory);
    } catch (dbError) {
      console.error("Database error updating category:", dbError);
      return NextResponse.json({
        error: "Database error updating category",
        details: dbError.message || "更新分类失败"
      }, { status: 500 });
    }
  } catch (error) {
    console.error("Error updating product category:", error);
    return NextResponse.json({
      error: "Failed to update product category",
      details: error instanceof Error ? error.message : "未知错误"
    }, { status: 500 });
  }
}
